{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm run:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Read(src/**)",
      "Read(public/**)",
      "Read(D:/FPTU/Capstone/docs/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(yarn:*)"
    ],
    "additionalDirectories": ["D:/FPTU/Capstone/docs"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/guard-protected-files.mjs"],
            "timeout": 10,
            "statusMessage": "Ki\u1ec3m tra file \u0111\u01b0\u1ee3c b\u1ea3o v\u1ec7"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/guard-package-manager.mjs"],
            "timeout": 10,
            "statusMessage": "Ki\u1ec3m tra package manager"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/format-changed-file.mjs"],
            "timeout": 45,
            "statusMessage": "Format file v\u1eeba s\u1eeda"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/remind-validate.mjs"],
            "timeout": 20,
            "statusMessage": "Ki\u1ec3m tra quy tr\u00ecnh verify"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
