# Copy this to .env.local and adjust values. These settings are server-only, except
# NEXT_PUBLIC_WS_URL at the end of this file (the one public value; see there).

# Spring Boot base URL INCLUDING /api/v1. Browser requests use the same-origin BFF.
API_URL=http://localhost:8080/api/v1

# Behind a reverse proxy, set the canonical PUBLIC origin for same-origin CSRF checks.
# Do not derive this from untrusted forwarded headers.
# APP_ORIGIN=https://your-backoffice.example.com

# Demo feature adapter + server-side mock auth sessions (never browser tokens).
USE_MOCK=true

# Spring Boot signs/validates JWTs. Next.js transports them in an HttpOnly cookie;
# no JWT signing secret or NEXT_PUBLIC backend REST URL is required by the frontend.
# Server-only, never NEXT_PUBLIC_*. Same value as nginx deploy/.env.
BFF_ORIGIN_SECRET=CHANGE_ME_openssl_rand_hex_32
# Only behind a reverse proxy that overwrites this header itself; leave unset on Vercel.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# Staff chat presence (STOMP over WebSocket) - the ONLY public variable. The browser opens the BE
# `/ws` endpoint directly (not through the BFF), e.g. wss://api.example.com/ws.
# - Inlined at `next build`: set it BEFORE building; changing it later needs a rebuild.
# - The back-office origin must be in the BE's CORS_ALLOWED_ORIGIN_PATTERNS: the WebSocket handshake
#   uses the same origin list (WebSocketConfig.registerStompEndpoints -> setAllowedOriginPatterns).
# - Unset = no socket, no error (presence just stays off).
# NEXT_PUBLIC_WS_URL=wss://api.example.com/ws
